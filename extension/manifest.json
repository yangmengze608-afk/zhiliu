{
  "manifest_version": 3,
  "name": "知流 · 信息面板",
  "version": "1.2.0",
  "description": "被动观察你在知乎真正读过的内容，把你的信息流变得可见。不改推荐，不做诊断。",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "shared/*.js", "core/*.js"],
      "matches": ["https://www.zhihu.com/*", "https://zhuanlan.zhihu.com/*"]
    }
  ]
}
